# FixTag API environment template
# Copy to .env and fill in values. NEVER commit real values to source control (FT-008 policy).
# Real secrets live in AWS Secrets Manager (fixtag/<env>) and host env files only.

NODE_ENV=
PORT=

# --- Database ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# SEC-B4: set DB_SSL=
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
# DB_SSL_CA=

# --- Auth secrets (REQUIRED, no defaults; generate with: openssl rand -base64 48) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# --- Approvals ---
# FT-002 Batch 2B-0: when true, a document with no resolvable tenant/provider-default
# workflow parks in PENDING_CONFIGURATION instead of auto-approving. Default OFF so the
# provider-default auto-approve path (Batch 2B-1) preserves legacy behavior. NOT consumed
# by code until Batch 2B-1 wires the engine — declared here so envs can set it ahead of time.
APPROVALS_REQUIRE_WORKFLOW=

# --- MFA ---
MFA_ENFORCE_PRIVILEGED=
MFA_BOOTSTRAP_BYPASS=
# TOTP-only MFA (Google/Microsoft Authenticator)
MFA_ISSUER=

# --- Bootstrap (fresh installs only; min 16 chars; see FT-008) ---
BOOTSTRAP_ADMIN_PASSWORD=

# --- Demo / test seeding (never set in production) ---
DEMO_SEED_PASSWORD=
REG_PASSWORD=

CLIENT_URL=
UPLOAD_DIR=
LOG_LEVEL=
LOG_RETENTION_DAYS=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_KMS_KEY_ID=

# --- QA smoke auth (MFA-aware) ---
QA_BASE_URL=
QA_TOKEN=
QA_USERNAME=
QA_PASSWORD=
# Provide one of these for MFA verification:
QA_MFA_OTP=
QA_MFA_TOTP_SECRET=
# When true, qa-smoke fails if verified auth flow is not used
QA_REQUIRE_VERIFIED_AUTH=
# Legacy local fallback token fields (used only when no QA_TOKEN/credentials provided)
QA_USER_ID=
QA_ROLE=
QA_CLIENT_ID=
QA_MFA_VERIFIED=

# --- AI vendor auto-fill (server-side only; never expose to the frontend) ---
OPENAI_API_KEY=
# Optional override; defaults to gpt-5.5
VENDOR_EXTRACTION_MODEL=

# --- Vendor emails from each admin's own mailbox ---
# 32-byte key (64 hex chars) that encrypts saved SMTP passwords: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_CREDENTIALS_KEY=

# --- One-click "Connect Google / Microsoft" for sending vendor emails (Settings → Email account) ---
# Register LedgerLine once with each provider; redirect URI = <OAUTH_REDIRECT_BASE_URL>/api/oauth/mail/<google|microsoft>/callback
# Public URL of this API (no trailing slash). Defaults to http://localhost:<PORT>.
OAUTH_REDIRECT_BASE_URL=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web). Enable the Gmail API. Scope: gmail.send
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Azure portal → Microsoft Entra ID → App registrations. Delegated Graph permissions: Mail.Send, User.Read, offline_access
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# "common" (any work/school or personal account), "organizations", or your tenant ID to allow only your company
MICROSOFT_OAUTH_TENANT=

# --- Settings → Security Settings → Integrations (company connections to external apps) ---
# Off (default) = preview: every app is listed with a Connect button, but no provider is ever called.
# Set true once the API integrations are built and the credentials below are filled in.
INTEGRATIONS_LIVE=
# 32-byte key (64 hex chars) that encrypts saved API keys and OAuth tokens. Falls back to MAIL_CREDENTIALS_KEY.
INTEGRATION_CREDENTIALS_KEY=
# OAuth redirect URI to register with each provider = <OAUTH_REDIRECT_BASE_URL>/api/integrations/oauth/<provider>/callback
# Zoho Books: api-console.zoho.in → Server-based Application. Redirect: .../api/integrations/oauth/zoho_books/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho data centre where users sign in: https://accounts.zoho.in (default), .com, .eu, .com.au, .jp ...
ZOHO_ACCOUNTS_URL=
# Optional: narrower scopes than ZohoBooks.fullaccess.all, comma-separated
ZOHO_BOOKS_SCOPES=
# NetSuite: Setup → Integration → Manage Integrations → New (Authorization Code Grant, REST Web Services scope).
# Redirect: .../api/integrations/oauth/netsuite/callback
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
# Optional: pre-fills the account ID on the connect form
NETSUITE_ACCOUNT_ID=
# Optional: Graph API version for the WhatsApp Business check (default v21.0)
WHATSAPP_GRAPH_VERSION=
# AWS Textract + Bedrock (server-wide). Uses AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above.
BEDROCK_MODEL_ID=
BEDROCK_REGION=
# true = allow Tally / SAP / GSP URLs on private networks (self-hosted or VPN). Always allowed outside production.
INTEGRATIONS_ALLOW_PRIVATE_URLS=

# Refresh-token cookie SameSite: strict (default) | lax | none. Use none when the client and API are on
# different domains (e.g. Vercel + Render); none only applies when NODE_ENV=production.
COOKIE_SAMESITE=

# Durable storage for uploads, for hosts whose disk is wiped on restart: db (MySQL table stored_files) or
# s3 (S3-compatible bucket: Amazon S3 / R2 / B2, using the STORAGE_* settings below). Empty = local disk only.
STORAGE_DRIVER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
