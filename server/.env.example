# FixTag API environment template
# Copy to .env and fill in values. NEVER commit real values to source control (FT-008 policy).
# Real secrets live in AWS Secrets Manager (fixtag/<env>) and host env files only.

NODE_ENV=
PORT=

# --- Database ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# SEC-B4: set DB_SSL=
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
# DB_SSL_CA=

# --- Auth secrets (REQUIRED, no defaults; generate with: openssl rand -base64 48) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# --- Approvals ---
# FT-002 Batch 2B-0: when true, a document with no resolvable tenant/provider-default
# workflow parks in PENDING_CONFIGURATION instead of auto-approving. Default OFF so the
# provider-default auto-approve path (Batch 2B-1) preserves legacy behavior. NOT consumed
# by code until Batch 2B-1 wires the engine — declared here so envs can set it ahead of time.
APPROVALS_REQUIRE_WORKFLOW=

# --- MFA ---
MFA_ENFORCE_PRIVILEGED=
MFA_BOOTSTRAP_BYPASS=
# TOTP-only MFA (Google/Microsoft Authenticator)
MFA_ISSUER=

# --- Bootstrap (fresh installs only; min 16 chars; see FT-008) ---
BOOTSTRAP_ADMIN_PASSWORD=

# --- Demo / test seeding (never set in production) ---
DEMO_SEED_PASSWORD=
REG_PASSWORD=

CLIENT_URL=
UPLOAD_DIR=
LOG_LEVEL=
LOG_RETENTION_DAYS=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_KMS_KEY_ID=

# --- QA smoke auth (MFA-aware) ---
QA_BASE_URL=
QA_TOKEN=
QA_USERNAME=
QA_PASSWORD=
# Provide one of these for MFA verification:
QA_MFA_OTP=
QA_MFA_TOTP_SECRET=
# When true, qa-smoke fails if verified auth flow is not used
QA_REQUIRE_VERIFIED_AUTH=
# Legacy local fallback token fields (used only when no QA_TOKEN/credentials provided)
QA_USER_ID=
QA_ROLE=
QA_CLIENT_ID=
QA_MFA_VERIFIED=
